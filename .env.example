# PostgreSQL
POSTGRES_DB=bidstream
POSTGRES_USER=bidstream
POSTGRES_PASSWORD=bidstream
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=bidstream
RABBITMQ_PASSWORD=bidstream
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=bidstream
MINIO_ROOT_PASSWORD=bidstream123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=bidstream

# MailHog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Backend (used by Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bidstream
SPRING_DATASOURCE_USERNAME=bidstream
SPRING_DATASOURCE_PASSWORD=bidstream
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=bidstream
SPRING_RABBITMQ_PASSWORD=bidstream
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=bidstream
MINIO_SECRET_KEY=bidstream123
MINIO_BUCKET=bidstream
